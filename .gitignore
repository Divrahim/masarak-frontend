
# ==========================================
# MASARAK - Frontend Git Ignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build
/dist

# Miscellaneous
.DS_Store
*.pem
*.log

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files - NEVER COMMIT SECRETS
.env
.env.*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Local development
*.local

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Operating system
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.bak

# Local Git repositories
/MASAR-GDG-Hackathon/
